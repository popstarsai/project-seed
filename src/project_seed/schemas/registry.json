{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seed registry v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "seeds"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "seeds": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "description", "capability", "required_scope", "enabled"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$", "maxLength": 64, "not": {"pattern": "\\s"}},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "maxLength": 32, "not": {"pattern": "\\s"}},
          "description": {"type": "string", "minLength": 1, "maxLength": 500},
          "capability": {"const": "memory.read_project"},
          "required_scope": {"const": "memory:read"},
          "enabled": {"type": "boolean"}
        }
      }
    }
  }
}

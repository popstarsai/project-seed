{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project memory snapshot v0.1",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "projects"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "projects": {
      "type": "array", "maxItems": 1000,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["project_id", "title", "summary", "decisions", "next_steps", "provenance"],
        "properties": {
          "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64, "not": {"pattern": "\\s"}},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "summary": {"type": "string", "minLength": 1, "maxLength": 6000},
          "decisions": {"$ref": "#/$defs/notes"},
          "next_steps": {"$ref": "#/$defs/notes"},
          "provenance": {
            "type": "object", "additionalProperties": false,
            "required": ["source", "updated_at"],
            "properties": {
              "source": {"type": "string", "minLength": 1, "maxLength": 500},
              "updated_at": {"type": "string", "format": "date-time"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "notes": {
      "type": "array", "maxItems": 20,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Seed activation proposal v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["seed_id", "project_id"],
  "properties": {
    "seed_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$", "maxLength": 64, "not": {"pattern": "\\s"}},
    "project_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$", "maxLength": 64, "not": {"pattern": "\\s"}}
  }
}
